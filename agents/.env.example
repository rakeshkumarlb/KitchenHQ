# Required for the default OpenAI provider.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# The Docker Compose service name is dbmcp. For a host-run agent use localhost.
MCP_URL=http://dbmcp:18000/mcp
MCP_TRANSPORT=streamable_http
DB_API_URL=http://dbmcp:18000
TZ=America/New_York

# Port agent-api listens on (used by chatui/agent-worker to reach it as AGENT_API_URL).
AGENT_API_PORT=8090

# Must match the KITCHENHQ_API_KEY set for the dbmcp service.
KITCHENHQ_API_KEY=

# Optional email notifications (app/email/). With SMTP_HOST set, the agents email the
# household Profile address via send_prep_task_email / send_weekly_plan_email /
# send_shopping_list_email. Best-effort: unset SMTP_HOST => tools return
# {"sent": false} and jobs are unaffected. notify_on_task_creation=0 on the profile
# suppresses all three. Recipient + saved-menu back-fill are fetched from dbmcp over
# DB_API_URL. Gmail: host smtp.gmail.com, port 587, username = full address, password
# = app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT=10
