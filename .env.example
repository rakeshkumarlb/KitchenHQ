# Used by docker-compose.yml's ${...} substitution when running `docker compose up`.
KITCHEN_DB_HOST_PATH=./data
KITCHEN_TIMEZONE=Asia/Kolkata

# Shared secret required on every dbmcp/chatui request (X-API-Key header).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
KITCHENHQ_API_KEY=

# Optional email notifications (agent-api / agents/app/email). When
# SMTP_HOST is set, the kitchen agents can email the Profile-page address via
# send_prep_task_email / send_weekly_plan_email / send_shopping_list_email (prep plans,
# the weekly menu, shopping suggestions). There is no automatic send. Leave SMTP_HOST
# blank to disable - jobs are unaffected either way. docker-compose passes these
# through to the agent-api service.
# Gmail example: host smtp.gmail.com, port 587, username = full address, password = app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SSL=true switches to implicit TLS (port 465); otherwise STARTTLS is used on 587.
SMTP_SSL=false
SMTP_STARTTLS=true
